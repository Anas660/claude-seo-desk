# Copy this file to .env and fill in what you have. Every key is optional: without any, SEO Desk still crawls,
# runs the GEO checks and scores each site; each key adds a step.

# The AI analyst's brief and the AI-visibility probes. An OpenRouter key (https://openrouter.ai/settings/keys) by
# default; any OpenAI-compatible API's key when config.yaml's llm.base_url points elsewhere.
LLM_API_KEY=

# Google rank checks for each site's keyword plan, https://serper.dev (about $1 per 1,000 searches).
SERPER_API_KEY=

# Search volumes and the keywords Google ranks each site for, https://app.dataforseo.com/api-access
# (the API login and API password, not the account password).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Set by `seodesk password`; don't edit by hand.
DASHBOARD_PASSWORD_HASH=
DASHBOARD_SECRET=
